# URL canonical dùng cho metadata, sitemap và dữ liệu SEO.
NEXT_PUBLIC_SITE_URL=https://phuongdev.io.vn

# Cron Vercel sẽ gửi giá trị này trong Authorization: Bearer <CRON_SECRET>.
# Tạo chuỗi ngẫu nhiên dài tối thiểu 16 ký tự; không commit giá trị thật.
CRON_SECRET=replace-with-a-long-random-secret
